    "newUsersThreshold": 5,
    "weights": {
      "NewRules": 3,
      "InboxRuleChanges": 3,
      "PermissionChangesTargetingUser": 2,
      "PermissionChanges": 1,
      "NewApps": 1,
      "NewUsers": 1,
      "SafelistChanges": 2,
