          "classification": "low"
        },
        "continueOnError": true
      },
      {
        "method": "POST",
        "uri": "servicePrincipals(appId='00000003-0000-0000-c000-000000000000')/delegatedPermissionClassifications",
        "body": {
          "permissionName": "openid",
          "classification": "low"
        },
        "continueOnError": true
      },
      {
        "method": "POST",
        "uri": "servicePrincipals(appId='00000003-0000-0000-c000-000000000000')/delegatedPermissionClassifications",
        "body": {
          "permissionName": "User.Read",
          "classification": "low"
        },
        "continueOnError": true
      },
      {
        "method": "POST",
        "uri": "servicePrincipals(appId='00000003-0000-0000-c000-000000000000')/delegatedPermissionClassifications",
        "body": {
          "permissionName": "profile",
