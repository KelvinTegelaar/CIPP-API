        {
          "label": "Microsoft managed",
          "value": "default"
        },
        {
          "label": "Enabled",
          "value": "enabled"
        },
        {
          "label": "Disabled",
          "value": "disabled"
        }
      ],
      "default": "enabled",
      "recommended": "enabled"
    }
  },
