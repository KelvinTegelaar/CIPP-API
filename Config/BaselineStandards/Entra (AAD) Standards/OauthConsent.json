{
  "name": "OauthConsent",
  "label": "Require admin consent for applications",
  "cat": "Entra (AAD) Standards",
  "tag": [
    "CIS M365 7.0.0 (5.3.1)"
  ],
  "impact": "Medium Impact",
  "helpText": "Requires admin consent before applications can access company data, with an optional allow-list of pre-approved application IDs.",
  "executiveText": "Stops staff from unknowingly authorising rogue applications; every new app needs IT sign-off.",
  "recommendedBy": [
    "CIS",
    "CIPP"
  ],
  "requiredCapabilities": [],
  "secureScoreImpact": 15,
  "compare": "subset",
  "variables": {
    "allowedApps": {
      "type": "textField",
      "label": "Pre-approved application IDs (comma separated)",
      "default": ""
    }
  },
  "expected": {
    "permissionGrantPolicyIdsAssignedToDefaultUserRole": [],
    "preApprovedApplications": "%allowedApps%"
  },
  "read": {
    "cacheType": "AuthorizationPolicy"
  },
  "remediate": {
    "executor": "GraphPatch",
    "uri": "policies/authorizationPolicy",
    "body": {
      "permissionGrantPolicyIdsAssignedToDefaultUserRole": []
    }
  }
}
