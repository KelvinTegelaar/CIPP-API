{
  "name": "FIDO2PasskeyProfiles",
  "label": "Configure FIDO2 Passkey Profiles",
  "cat": "Entra (AAD) Standards",
  "tag": [],
  "impact": "Medium Impact",
  "helpText": "Configures the default passkey profile. Most tenants should leave AAGUID restrictions off. When you restrict to an allow list, Windows Hello and Microsoft Authenticator passkeys stay allowed by default; turning \"Always allow Microsoft passkeys\" off rejects them as not meeting the profile's criteria. Other profiles are never touched.",
  "executiveText": "Controls which passkey authenticators the organization accepts - device-bound versus synced, and optionally an explicit allow or block list of authenticator models.",
  "docsDescription": "Grades the default passkey profile's passkey types, attestation enforcement, key restriction enforcement, restriction type and sorted AAGUID set. Remediation rewrites the default profile in place, resending every other profile untouched.\n\nAn AAGUID identifies an authenticator model (a YubiKey series, Windows Hello, Microsoft Authenticator). Entering any AAGUIDs turns key restrictions on. In allow mode, every authenticator not on the list is refused at registration and sign-in, including Windows Hello and Authenticator passkeys, unless \"Always allow Microsoft passkeys\" stays on (the default). That switch adds the Windows Hello (08987058-cadc-4b81-b6e1-30de50dcbe96, 9ddd1817-af5a-4672-a2b9-3e3dd95000a9, 6028b017-b1d4-4c02-b4b3-afcdafc96bb2) and Authenticator (Android de1e552d-db1d-4423-a619-566b625cdc84, iOS 90a3ccdf-635c-4729-a248-9b709135078f) AAGUIDs to the allow list, and on its own with restrictions enforced allows only those. It has no effect in block mode or while restrictions are off.\n\nCommon setups: allowing synced passkeys (Apple, Google, password managers) - attestation Disabled and no AAGUID restrictions, as Microsoft recommends. Device-bound only with approved hardware keys - allow mode, and the keys' AAGUIDs. Blocking a specific model - block mode with its AAGUID. Windows Hello passkeys and Authenticator cross-device registration need attestation Disabled.",
  "impactColour": "warning",
  "addedDate": "2026-08-16",
  "powershellEquivalent": "Graph: PATCH authenticationMethodConfigurations/Fido2",
  "recommendedBy": [],
  "requiredCapabilities": [
    "AAD_PREMIUM",
    "AAD_PREMIUM_P2"
  ],
  "disabledFeatures": {
    "report": false,
    "warn": false,
    "remediate": false
  },
  "secureScoreImpact": 0,
  "compare": "subset",
  "variables": {
    "PasskeyTypes": {
      "creatable": false,
      "options": [
        {
          "value": "deviceBound",
          "label": "Device-bound only"
        },
        {
          "value": "synced",
          "label": "Synced only"
        },
        {
          "value": "deviceBound,synced",
          "label": "Both device-bound and synced"
        }
      ],
      "required": true,
      "type": "autoComplete",
      "label": "Allowed Passkey Types",
      "helperText": "Synced passkeys (Apple, Google, password managers) require attestation Disabled. Windows Hello and Authenticator passkeys are device-bound."
    },
    "AttestationEnforcement": {
      "creatable": false,
      "options": [
        {
          "value": "disabled",
          "label": "Disabled (required for synced passkeys)"
        },
        {
          "value": "registrationOnly",
          "label": "Registration only"
        }
      ],
      "required": true,
      "type": "autoComplete",
      "label": "Attestation Enforcement",
      "helperText": "Windows Hello passkeys and Authenticator cross-device registration only work with attestation Disabled."
    },
    "EnforceKeyRestrictions": {
      "label": "Enforce AAGUID Key Restrictions",
      "type": "switch",
      "default": false,
      "helperText": "Turn on only if you need to limit which authenticator models can register; it reveals the restriction settings."
    },
    "EnforcementType": {
      "creatable": false,
      "options": [
        {
          "value": "allow",
          "label": "Allow listed AAGUIDs only"
        },
        {
          "value": "block",
          "label": "Block listed AAGUIDs"
        }
      ],
      "omitWhenBlank": true,
      "type": "autoComplete",
      "label": "Key Restriction Type",
      "helperText": "Allow refuses every authenticator not listed. Block refuses only the listed ones.",
      "condition": {
        "field": "EnforceKeyRestrictions",
        "compareType": "is",
        "compareValue": true
      }
    },
    "AllowMicrosoftPasskeys": {
      "label": "Always allow Microsoft passkeys (Windows Hello + Authenticator)",
      "type": "switch",
      "default": true,
      "helperText": "On by default. Adds the Windows Hello and Microsoft Authenticator AAGUIDs to the allow list so those passkeys keep working. No effect in block mode.",
      "condition": {
        "field": "EnforceKeyRestrictions",
        "compareType": "is",
        "compareValue": true
      }
    },
    "AAGUIDs": {
      "label": "AAGUIDs",
