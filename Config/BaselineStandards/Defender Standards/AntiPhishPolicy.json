{
  "name": "AntiPhishPolicy",
  "label": "Default Anti-Phishing Policy",
  "cat": "Defender Standards",
  "tag": [
    "CIS M365 7.0.0 (2.1.7)",
    "NIST CSF 2.0 (DE.CM-09)",
    "mdo_antiphishingpolicies",
    "mdo_phishthresholdlevel",
    "mdo_enablemailboxintelligence",
    "mdo_mailboxintelligenceprotection",
    "mdo_mailboxintelligenceprotectionaction",
    "mdo_targetedusersprotection",
    "mdo_enabledomainstoprotect",
    "mdo_targeteduserprotectionaction",
    "mdo_targeteddomainprotectionaction",
    "mdo_similaruserssafetytips",
    "mdo_similardomainssafetytips",
    "mdo_unusualcharacterssafetytips",
    "CMMC (SI.L2-3.14.6)",
    "NIST SP 800-171 (3.14.6)"
  ],
  "impact": "Low Impact",
  "helpText": "This creates an Anti-Phishing policy. On tenants without Defender for Office 365 only the settings that exist there are graded; impersonation and mailbox-intelligence protection are skipped. With Defender for Office 365, the protected user list is left as it is unless you choose All licensed users, which matches it to licensed user mailboxes and keeps existing external entries, or Only the users listed, which replaces it.",
  "executiveText": "Detects attempts to impersonate staff and partner domains, and warns employees about unusual or first-contact senders. This is the main defence against business email compromise.",
  "docsDescription": "Creates or updates the Anti-Phishing policy and the rule that scopes it to every accepted domain. The graded property set depends on tenant licensing. With Defender for Office 365 it can also manage the users and custom domains protected from impersonation: every enabled, licensed member with a user mailbox plus any listed users and the external entries already in the policy, or only the listed users. By default the protected user list is left as it is. Exchange allows 350 users and 50 custom domains per policy.",
  "impactColour": "info",
  "addedDate": "2024-03-25",
  "powershellEquivalent": "Set-AntiPhishPolicy or New-AntiPhishPolicy",
  "appliesToTest": [
    "CIS_2_1_7"
  ],
  "recommendedBy": [
    "CIS"
  ],
  "requiredCapabilities": [
    "EXCHANGE_S_STANDARD",
    "EXCHANGE_S_ENTERPRISE",
    "EXCHANGE_S_STANDARD_GOV",
    "EXCHANGE_S_DESKLESS",
    "EXCHANGE_S_ENTERPRISE_GOV",
    "EXCHANGE_LITE"
  ],
  "secureScoreImpact": 72,
  "compare": "subset",
  "variables": {
    "name": {
      "type": "textField",
      "label": "Policy Name",
      "required": true,
      "default": "CIPP Default Anti-Phishing Policy"
    },
    "PhishThresholdLevel": {
      "type": "select",
      "multiple": false,
      "label": "Phishing Threshold Level",
      "required": true,
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "default": "3"
    },
    "EnableFirstContactSafetyTips": {
      "type": "switch",
      "label": "First contact safety tips",
      "default": true
    },
    "EnableSimilarUsersSafetyTips": {
      "type": "switch",
      "label": "Similar users safety tips",
      "default": true
    },
    "EnableSimilarDomainsSafetyTips": {
      "type": "switch",
      "label": "Similar domains safety tips",
      "default": true
    },
    "EnableUnusualCharactersSafetyTips": {
      "type": "switch",
      "label": "Unusual characters safety tips",
      "default": true
    },
    "AuthenticationFailAction": {
      "type": "select",
      "multiple": false,
      "label": "Authentication fail action",
      "required": true,
      "options": [
        {
          "label": "MoveToJmf",
          "value": "MoveToJmf"
        },
        {
          "label": "Quarantine",
          "value": "Quarantine"
        }
      ],
      "default": "MoveToJmf"
    },
    "SpoofQuarantineTag": {
      "type": "select",
      "creatable": true,
      "multiple": false,
      "label": "Spoof quarantine tag",
      "required": true,
      "options": [
        {
          "label": "AdminOnlyAccessPolicy",
          "value": "AdminOnlyAccessPolicy"
        },
        {
          "label": "DefaultFullAccessPolicy",
          "value": "DefaultFullAccessPolicy"
        },
        {
          "label": "DefaultFullAccessWithNotificationPolicy",
          "value": "DefaultFullAccessWithNotificationPolicy"
        }
      ],
      "default": "DefaultFullAccessPolicy"
    },
    "MailboxIntelligenceProtectionAction": {
      "type": "select",
      "multiple": false,
      "label": "Mailbox intelligence protection action",
      "required": true,
      "options": [
        {
          "label": "NoAction",
          "value": "NoAction"
        },
        {
          "label": "MoveToJmf",
          "value": "MoveToJmf"
        },
        {
          "label": "Delete",
          "value": "Delete"
        },
        {
          "label": "Quarantine",
          "value": "Quarantine"
        }
      ],
      "default": "Quarantine"
    },
    "MailboxIntelligenceQuarantineTag": {
      "type": "select",
      "creatable": true,
      "multiple": false,
      "label": "Mailbox intelligence quarantine tag",
      "required": true,
      "options": [
        {
          "label": "AdminOnlyAccessPolicy",
          "value": "AdminOnlyAccessPolicy"
        },
        {
          "label": "DefaultFullAccessPolicy",
          "value": "DefaultFullAccessPolicy"
        },
        {
          "label": "DefaultFullAccessWithNotificationPolicy",
          "value": "DefaultFullAccessWithNotificationPolicy"
        }
      ],
      "default": "DefaultFullAccessPolicy"
    },
    "TargetedUserProtectionAction": {
      "type": "select",
      "multiple": false,
      "label": "Targeted user protection action",
      "required": true,
      "options": [
        {
          "label": "NoAction",
          "value": "NoAction"
        },
        {
          "label": "MoveToJmf",
          "value": "MoveToJmf"
        },
        {
          "label": "Delete",
          "value": "Delete"
        },
        {
          "label": "Quarantine",
          "value": "Quarantine"
        }
      ],
      "default": "Quarantine"
    },
    "TargetedUserQuarantineTag": {
      "type": "select",
      "creatable": true,
      "multiple": false,
      "label": "Targeted user quarantine tag",
      "required": true,
      "options": [
        {
          "label": "AdminOnlyAccessPolicy",
          "value": "AdminOnlyAccessPolicy"
        },
        {
          "label": "DefaultFullAccessPolicy",
          "value": "DefaultFullAccessPolicy"
        },
        {
          "label": "DefaultFullAccessWithNotificationPolicy",
          "value": "DefaultFullAccessWithNotificationPolicy"
        }
      ],
      "default": "DefaultFullAccessPolicy"
    },
    "TargetedDomainProtectionAction": {
      "type": "select",
      "multiple": false,
      "label": "Targeted domain protection action",
      "required": true,
      "options": [
        {
          "label": "NoAction",
          "value": "NoAction"
        },
        {
          "label": "MoveToJmf",
          "value": "MoveToJmf"
        },
        {
          "label": "Delete",
          "value": "Delete"
        },
        {
          "label": "Quarantine",
          "value": "Quarantine"
        }
      ],
      "default": "Quarantine"
    },
    "TargetedDomainQuarantineTag": {
      "type": "select",
      "creatable": true,
      "multiple": false,
      "label": "Targeted domain quarantine tag",
      "required": true,
      "options": [
        {
          "label": "AdminOnlyAccessPolicy",
          "value": "AdminOnlyAccessPolicy"
        },
        {
          "label": "DefaultFullAccessPolicy",
          "value": "DefaultFullAccessPolicy"
        },
        {
          "label": "DefaultFullAccessWithNotificationPolicy",
          "value": "DefaultFullAccessWithNotificationPolicy"
        }
      ],
      "default": "DefaultFullAccessPolicy"
    },
    "ImpersonationUserScope": {
      "type": "autoComplete",
      "multiple": false,
      "creatable": false,
      "label": "Users to protect from impersonation",
      "helperText": "Keep the tenant's current list, the default, leaves the policy's list as it is. All licensed users protects every enabled, licensed member with a user mailbox, plus the users listed below and any external entries already in the policy. Only the users listed replaces the policy's list with the list below. Exchange allows 350 users per policy. With mailbox intelligence on, user impersonation protection applies before the sender and recipient have emailed each other.",
      "required": true,
      "options": [
        {
          "label": "Keep the tenant's current list",
          "value": "Unmanaged"
        },
        {
          "label": "All licensed users",
          "value": "AllLicensed"
        },
        {
          "label": "Only the users listed",
          "value": "Listed"
        }
      ],
      "default": "Unmanaged"
    },
    "TargetedUsersToProtect": {
      "type": "autoComplete",
      "multiple": true,
      "creatable": true,
      "label": "Users to protect",
      "helperText": "Used with All licensed users or Only the users listed. Enter Display Name;address or just the address, for example CEO;ceo@contoso.com. Tenant variables such as %keypeople% are expanded for each tenant. A bare address uses its mailbox's display name when available. Enter a name to override it. Different names can share an address.",
      "omitWhenBlank": true,
      "default": ""
    },
    "TargetedDomainsToProtect": {
      "type": "autoComplete",
      "multiple": true,
      "creatable": true,
      "label": "Custom domains to protect",
      "helperText": "Partner or supplier domains, for example fabrikam.com. Leave blank to leave the policy's list as it is; the tenant's own domains are always protected. Exchange allows 50 domains per policy.",
      "omitWhenBlank": true,
      "default": ""
    }
  },
  "read": {
    "cacheType": "ExoAntiPhishPolicies"
  },
  "prepare": "Get-CIPPBaselineAntiPhishPolicyState",
  "remediate": {
    "executor": "ExoPolicyRule",
    "policyCmdlet": "AntiPhishPolicy",
    "ruleCmdlet": "AntiPhishRule",
    "policyParams": {
      "Enabled": true,
      "EnableSpoofIntelligence": true,
      "EnableUnauthenticatedSender": true,
      "EnableViaTag": true,
      "EnableFirstContactSafetyTips": "%EnableFirstContactSafetyTips%",
      "AuthenticationFailAction": "%AuthenticationFailAction%",
      "SpoofQuarantineTag": "%SpoofQuarantineTag%"
    },
    "ruleParams": {
      "Priority": 0
    }
  }
}
