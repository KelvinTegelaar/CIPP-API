{
  "name": "ConditionalAccessTemplate",
  "label": "Conditional Access Template",
  "cat": "Templates",
  "tag": [
    "CIS M365 7.0.0 (5.2.2.1)",
    "CIS M365 7.0.0 (5.2.2.2)",
    "CIS M365 7.0.0 (5.2.2.3)",
