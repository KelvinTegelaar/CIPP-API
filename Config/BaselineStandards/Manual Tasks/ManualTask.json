{
  "name": "ManualTask",
  "label": "Manual Task",
  "cat": "Manual Tasks",
  "tag": [
    "Manual"
  ],
  "impact": "Low Impact",
  "helpText": "Describes an action an operator must perform by hand. CIPP raises a deviation on the configured recurrence until the task is marked complete, so manual work shows up in the same alignment view as automated standards.",
  "executiveText": "A recurring operational task performed by an engineer, tracked and evidenced alongside the automated controls.",
  "recommendedBy": [
    "CIPP"
  ],
  "requiredCapabilities": [],
  "secureScoreImpact": 0,
  "compare": "subset",
  "multiple": true,
  "variables": {
    "taskName": {
      "type": "textField",
      "label": "Task name",
      "default": ""
    },
    "instructions": {
      "type": "textField",
      "label": "Instructions for the operator",
      "default": ""
    },
    "documentationUrl": {
      "type": "textField",
      "label": "Documentation link (optional)",
      "default": ""
    },
    "recurrence": {
      "type": "autoComplete",
      "label": "Reopen the task every",
      "options": [
        {
          "label": "Week",
          "value": "weekly"
        },
        {
          "label": "Month",
          "value": "monthly"
        },
        {
          "label": "Quarter",
          "value": "quarterly"
        },
        {
          "label": "Never (one-time task)",
          "value": "once"
        }
      ],
      "default": "monthly"
    }
  },
  "expected": {
    "completed": true
  },
  "manual": {
    "taskName": "%taskName%",
    "instructions": "%instructions%",
    "documentationUrl": "%documentationUrl%",
    "reopen": "%recurrence%"
  }
}
