<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CIPPSharp</AssemblyName>
    <RootNamespace>CIPP</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- No deps.json is generated (GenerateDependencyFile=false), so NuGet runtime assemblies must be
         copied physically next to CIPPSharp.dll for the PowerShell host to resolve them by same-dir probing. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: ExcludeAssets="runtime" keeps the System.Management.Automation facade out of bin\
         (PowerShell supplies the real assembly at runtime) while still compiling against its types. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Server-side PDF renderer. MIT, zero third-party deps: only OfficeIMO.Pdf.dll + OfficeIMO.Core.dll land in bin\.
         INTERIM: vendored net8.0 builds of OfficeIMO 3.4.3 (unreleased) from upstream master 399adf1d1, which
         carries the report-generation performance work (#2577: table layout, text/number formatting, image reuse
         and segmented object storage; output unchanged), measured with build/tools/pdf-bench. Once a release
         ships that work, restore <PackageReference Include="OfficeIMO.Pdf" Version="..." /> and delete lib\. -->
    <Reference Include="OfficeIMO.Pdf" HintPath="lib\OfficeIMO.Pdf.dll" />
    <Reference Include="OfficeIMO.Core" HintPath="lib\OfficeIMO.Core.dll" />
  </ItemGroup>
</Project>
